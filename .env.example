# GridSense AI - Ingestion Layer Configuration
# Rename this file to .env and fill in the credentials.

# System Settings
LOG_LEVEL=INFO
LOG_DIR=logs
RAW_DATA_DIR=data/raw

# Ingestion API Settings
API_TIMEOUT_SEC=15
API_MAX_RETRIES=5
API_BACKOFF_FACTOR=2.0

# API Credentials
# Get OGD API Key from data.gov.in (requires registration)
DATAGOV_API_KEY=YOUR_DATAGOV_IN_API_KEY_HERE

# Get WAQI Token from aqicn.org/api/ (free developer token)
WAQI_API_TOKEN=YOUR_WAQI_API_TOKEN_HERE
